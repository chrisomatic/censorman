# Dockerfile.build - Builds censorman binary against Debian Bookworm (GLIBC 2.36)
# Usage:
#   docker build -f Dockerfile.build -t censorman-builder .
#   docker create --name extract censorman-builder
#   docker cp extract:/censorman/bin/censorman ./censorman/bin/censorman
#   docker rm extract

FROM debian:bookworm

RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    cmake \
    make \
    git \
    nasm \
    yasm \
    autoconf \
    automake \
    autopoint \
    libtool \
    pkg-config \
    python3 \
    zlib1g-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /censorman

# Copy the entire project
COPY . .

# Build all deps then build censorman
RUN ./scripts/build_deps.sh all
RUN ./build.sh prod
